# .env.example — copy this to .env and fill in any values you need.
# The base tutorial fetches data from Yahoo Finance (no key required).
# If you extend the assistant to use paid data providers, add keys here.

# Optional: override the portfolio file path (default: portfolio.pkl in project root)
# PORTFOLIO_FILE=portfolio.pkl

# Optional: override the saved model file prefix (default: financial_assistant_model)
# MODEL_NAME=financial_assistant_model

# Optional: Alpha Vantage API key if you swap pandas-datareader backend
# ALPHA_VANTAGE_KEY=your_key_here
